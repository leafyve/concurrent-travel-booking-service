# ---------------------------------------------------------------------------
# Example environment configuration. Copy to `.env` and adjust for local dev.
# NEVER commit a real `.env`. These are safe, non-production placeholders.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=false

# --- Database ---------------------------------------------------------------
# psycopg3 driver powers both the async app engine and sync Alembic.
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth (JWT) -------------------------------------------------------------
# Generate a real secret for anything shared: `openssl rand -hex 32`
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30

# --- Reservations -----------------------------------------------------------
RESERVATION_TTL_MINUTES=10

# --- Payment webhooks -------------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me-webhook-shared-secret
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# --- Workers ----------------------------------------------------------------
EXPIRY_BATCH_SIZE=100
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=8
WORKER_POLL_INTERVAL_SECONDS=2.0

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
